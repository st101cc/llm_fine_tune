# Compass (OpenAI-compatible) settings for the trainer. Copy to .env in this
# directory on the GPU backend and set real values there; never commit .env.
# Used by the optional dataset advisor, the model-picking agent, and Compass
# models in benchmarks. ADVISOR_BASE_URL must be
# https://compass.llm.shopee.io/compass-api/v1
ADVISOR_BASE_URL=
ADVISOR_API_KEY=
ADVISOR_MODEL=gpt-4.1-mini

# Local automatic evaluator (must already be cached on the GPU backend).
# Fixed for a workflow; no dataset answers are sent to a hosted service.
EVALUATOR_MODEL=Qwen/Qwen2.5-7B-Instruct
