# Optional dataset-analysis advisor; requires an OpenAI-compatible endpoint.
# Copy to .env in this directory and set real values locally.
# This hook does not automatically benchmark external models.
ADVISOR_BASE_URL=
ADVISOR_API_KEY=
ADVISOR_MODEL=

# Local automatic evaluator (must already be cached on the GPU backend).
# Fixed for a workflow; no dataset answers are sent to a hosted service.
EVALUATOR_MODEL=Qwen/Qwen2.5-7B-Instruct
